# Google AI API Key (for Gemini API if using cloud version)
GOOGLE_API_KEY=your_api_key_here

# Hugging Face Token (for downloading Gemma models)
HF_TOKEN=your_huggingface_token_here

# Model Configuration
USE_LOCAL_MODEL=true
MODEL_PATH=./models/gemma-2b-it

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=1
MAX_LENGTH=512
